{
  "name": "ghostery-extension",
  "private": true,
  "version": "10.5.57",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build -- --watch",
    "start:update": "./scripts/update.sh",
    "debug": "npm run build -- --watch --debug",
    "lint": "npm run lint:src && npm run lint:build && npm run lint:permissions",
    "lint:src": "eslint",
    "lint:build": "npm run build firefox -- --silent && web-ext lint",
    "lint:permissions": "node scripts/check-permissions.js",
    "test": "npm run test:unit && npm run wdio && npm run wdio:update",
    "test:unit": "node --import ./tests/unit/setup/register-import.js --test",
    "wdio": "wdio tests/e2e/wdio.conf.js",
    "wdio:update": "wdio tests/e2e/wdio.update.conf.js",
    "wdio:page": "node tests/e2e/page/server.js",
    "locales:setup": "cp -f ./src/messages.json ./src/_locales/en/messages.json",
    "locales.src": "hybrids extract -c --format=chrome.i18n ./src ./src/_locales/en/messages.json",
    "locales": "npm run locales:setup && npm run locales.src",
    "xcode-export-locales": "rm -rf ./xcode/en.xcloc && xcodebuild -exportLocalizations -project ./xcode/Ghostery.xcodeproj -localizationPath ./xcode",
    "release": "./scripts/release.sh",
    "package": "./scripts/package.sh",
    "app-store-connect": "node scripts/app-store-connect.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.6",
    "@wdio/browser-runner": "^9.31.1",
    "@wdio/cli": "^9.31.1",
    "@wdio/globals": "^9.31.1",
    "@wdio/mocha-framework": "^9.31.1",
    "@wdio/spec-reporter": "^9.31.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "license-report": "^6.8.5",
    "prettier": "^3.9.6",
    "vite": "^8.2.1",
    "web-ext": "^10.6.0"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "^16.23.0",
    "@ghostery/adblocker": "^2.18.2",
    "@ghostery/adblocker-content": "^2.18.2",
    "@ghostery/adblocker-extended-selectors": "^2.18.2",
    "@ghostery/adblocker-webextension": "^2.18.2",
    "@ghostery/config": "^0.0.17",
    "@ghostery/scriptlets": "github:ghostery/scriptlets",
    "@ghostery/urlfilter2dnr": "^2.0.4",
    "@github/relative-time-element": "^5.3.1",
    "@sentry/browser": "^10.70.0",
    "@whotracksme/reporting": "^12.0.0",
    "apexsankey": "github:ghostery/apexsankey",
    "bowser": "^2.14.1",
    "csv-stringify": "^6.8.3",
    "hybrids": "^9.1.23",
    "idb": "^8.0.3",
    "lottie-web": "^5.13.0",
    "minixxh": "^0.4.0",
    "plotly.js-basic-dist": "^3.7.0",
    "tldts-experimental": "^7.4.10"
  },
  "overrides": {
    "yauzl": "3.4.0"
  },
  "dataDependencies": {
    "redirect-resources": "1b8d5bb8a314010b78abfc8b897bbf6977fce2bc1cffda103be6ae290718169a",
    "wtm-bloomfilter": "2026-08-17",
    "wtm-stats": "40ea9d48960e75bdc059931e56c01c8dc0856c8d"
  },
  "engineStrict": true,
  "engines": {
    "npm": ">=11.17.0"
  },
  "webExt": {
    "sourceDir": "./dist/"
  },
  "author": {
    "name": "Ghostery GmbH",
    "email": "info@ghostery.com",
    "url": "https://www.ghostery.com"
  },
  "license": "GPL-3.0"
}
