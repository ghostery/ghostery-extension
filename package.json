{
  "name": "ghostery-extension",
  "private": true,
  "version": "10.6.9",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build -- --watch",
    "start:update": "./scripts/update.sh",
    "debug": "npm run build -- --watch --debug",
    "lint": "npm run lint:src && npm run lint:build && npm run lint:permissions",
    "lint:src": "eslint",
    "lint:build": "npm run build firefox -- --silent && web-ext lint",
    "lint:permissions": "node scripts/check-permissions.js",
    "test": "npm run test:unit && npm run wdio && npm run wdio:update",
    "test:unit": "node --import ./tests/unit/setup/register-import.js --experimental-test-module-mocks --test",
    "wdio": "wdio tests/e2e/wdio.conf.js",
    "wdio:update": "wdio tests/e2e/wdio.update.conf.js",
    "wdio:page": "node tests/e2e/page/server.js",
    "locales:setup": "cp -f ./src/messages.json ./src/_locales/en/messages.json",
    "locales.src": "hybrids extract -c --format=chrome.i18n ./src ./src/_locales/en/messages.json",
    "locales": "npm run locales:setup && npm run locales.src",
    "xcode-export-locales": "rm -rf ./xcode/en.xcloc && xcodebuild -exportLocalizations -project ./xcode/Ghostery.xcodeproj -localizationPath ./xcode",
    "release": "./scripts/release.sh",
    "package": "./scripts/package.sh",
    "app-store-connect": "node scripts/app-store-connect.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@wdio/browser-runner": "^10.0.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "license-report": "^6.8.6",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "^16.54.0",
    "@ghostery/adblocker": "^2.20.1",
    "@ghostery/adblocker-content": "^2.20.1",
    "@ghostery/adblocker-extended-selectors": "^2.20.1",
    "@ghostery/adblocker-webextension": "^2.20.1",
    "@ghostery/config": "^0.0.18",
    "@ghostery/scriptlets": "github:ghostery/scriptlets",
    "@ghostery/urlfilter2dnr": "^2.1.0",
    "@github/relative-time-element": "^5.3.1",
    "@sentry/browser": "^11.8.0",
    "@whotracksme/reporting": "^12.1.6",
    "apexsankey": "github:ghostery/apexsankey",
    "bowser": "^2.14.1",
    "csv-stringify": "^6.9.0",
    "hybrids": "^9.2.1",
    "idb": "^8.0.4",
    "lottie-web": "^5.13.0",
    "minixxh": "^0.4.0",
    "plotly.js-basic-dist": "^4.1.2",
    "tldts-experimental": "^7.4.18"
  },
  "overrides": {
    "yauzl": "3.4.0"
  },
  "dataDependencies": {
    "redirect-resources": "c8cb1ee914a674c16763ca3d2de70179c0f2b33d6ccacf0dfb09a82242592d52",
    "wtm-bloomfilter": "2026-10-19",
    "wtm-stats": "80e56b2aa15c813c62915d4cf5ab4afa14625870"
  },
  "engineStrict": true,
  "engines": {
    "npm": ">=11.17.0"
  },
  "webExt": {
    "sourceDir": "./dist/"
  },
  "author": {
    "name": "Ghostery GmbH",
    "email": "info@ghostery.com",
    "url": "https://www.ghostery.com"
  },
  "license": "GPL-3.0"
}
