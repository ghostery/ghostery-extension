  "strings" : {
    "A few quick questions about setting up and using Ghostery on your Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein paar kurze Fragen zur Einrichtung und Nutzung von Ghostery auf deinem Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unas preguntas rápidas sobre cómo configurar y usar Ghostery en tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques questions rapides sur l’installation et l’utilisation de Ghostery sur votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune domande veloci sulla configurazione e sull’uso di Ghostery sul tuo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacでのGhosteryの設定と使い方について、簡単な質問にお答えください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 Ghostery를 설정하고 사용하는 방법에 관한 몇 가지 간단한 질문입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
