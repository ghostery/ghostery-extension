    "As a Contributor, you’ll support the development of the entire Ghostery Privacy Suite" : {
      "comment" : "Ghostery Privacy Suite is the name of all Ghostery’s products",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Förderer unterstützt du die Entwicklung der gesamten Ghostery Privacy Suite"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como contribuyente, apoyarás el desarrollo de toda la Ghostery Privacy Suite"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tant que donateur, vous soutenez le développement de toute la Ghostery Privacy Suite"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come collaboratore, sosterrai lo sviluppo dell’intera Ghostery Privacy Suite"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contributorとして、Ghostery Privacy Suite全体の開発を支援できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
