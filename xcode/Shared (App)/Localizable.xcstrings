        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một vài câu hỏi nhanh về cách thiết lập và sử dụng Ghostery trên máy Mac của bạn."
          }
        },
        "zh-Hans" : {
