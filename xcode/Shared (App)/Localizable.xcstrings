            "state" : "translated",
            "value" : "Mit Ghostery behältst du im gesamten Web die Kontrolle über deine Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery te ayuda a tomar el control de tus datos en toda la web."
          }
        },
        "fr" : {
          "stringUnit" : {
