    "Help Ghostery fight for a web where privacy is a basic human right." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilf Ghostery, für ein Web zu kämpfen, in dem Privatsphäre ein grundlegendes Menschenrecht ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda a Ghostery a luchar por una web en la que la privacidad sea un derecho humano básico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aidez Ghostery à lutter pour un Web où la vie privée est un droit humain fondamental."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiuta Ghostery a lottare per un web dove la privacy è un diritto umano fondamentale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーを基本的人権とするウェブのために、Ghosteryと共に戦いましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery가 개인정보 보호가 곧 기본권인 웹 생태계를 위해 싸울 수 있도록 도와주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomóż Ghostery w walce o sieć, w której prywatność jest podstawowym prawem człowieka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajude o Ghostery a lutar por uma web onde a privacidade é um direito humano básico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помогите Ghostery бороться за интернет, где конфиденциальность — одно из основных прав человека."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy giúp Ghostery đấu tranh cho một nền web nơi quyền riêng tư là quyền cơ bản của con người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
