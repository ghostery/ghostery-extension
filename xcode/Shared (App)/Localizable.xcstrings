    "To check if Ghostery is enabled in %@, open System Settings, click %@, and turn on %@." : {
      "comment" : "Shown when the app can't read the data of the browsers. The first placeholder is the list of the browsers, the second one the name of the app, and the last one the list of the browsers, as named in System Settings, which is the name of the macOS app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um zu prüfen, ob Ghostery in %1$@ aktiviert ist, öffne die Systemeinstellungen, klicke auf %2$@ und aktiviere %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To check if Ghostery is enabled in %1$@, open System Settings, click %2$@, and turn on %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para comprobar si Ghostery está activado en %1$@, abre Ajustes del Sistema, haz clic en %2$@ y activa %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vérifier si Ghostery est activé dans %1$@, ouvrez Réglages Système, cliquez sur %2$@ et activez %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per verificare se Ghostery è attivo in %1$@, apri Impostazioni di Sistema, fai clic su %2$@ e attiva %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@でGhosteryが有効になっているか確認するには、システム設定を開いて%2$@をクリックし、%3$@をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 Ghostery가 활성화되어 있는지 확인하려면 시스템 설정을 열고 %2$@ 항목을 클릭한 다음 %3$@ 스위치를 켜세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby sprawdzić, czy Ghostery jest włączone w %1$@, otwórz Ustawienia systemowe, kliknij %2$@ i włącz %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para verificar se o Ghostery está ativado em %1$@, abra os Ajustes do Sistema, clique em %2$@ e ative %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы проверить, включен ли Ghostery в %1$@, откройте Системные настройки, нажмите %2$@ и включите %3$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để kiểm tra Ghostery có được bật trong %1$@ hay không, hãy mở Cài đặt hệ thống, bấm vào %2$@ và bật %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要检查 Ghostery 是否已在 %1$@ 中启用，请打开系统设置，点按 %2$@，然后打开 %3$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要檢查 Ghostery 是否已在 %1$@ 中啟用，請打開系統設定，按一下 %2$@，然後開啟 %3$@。"
          }
        }
      }
    },
