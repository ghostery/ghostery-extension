    "Every contribution, big or small, is invaluable to our mission and future." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Beitrag, ob groß oder klein, ist für unsere Mission und unsere Zukunft von unschätzbarem Wert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada contribución, grande o pequeña, es muy valiosa para nuestra misión y nuestro futuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque contribution, petite ou grande, est précieuse pour notre mission et notre avenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni contributo, grande o piccolo, è prezioso per la nostra missione e il nostro futuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大小にかかわらず、すべてのご支援が私たちのミッションと未来にとってかけがえのないものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크든 작든 모든 기여는 저희의 사명과 미래에 매우 소중합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy wkład, duży czy mały, jest bezcenny dla naszej misji i przyszłości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda contribuição, grande ou pequena, é inestimável para a nossa missão e o nosso futuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый вклад, большой или маленький, бесценен для нашей миссии и будущего."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi đóng góp, dù lớn hay nhỏ, đều vô cùng quý giá với sứ mệnh và tương lai của chúng tôi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一份贡献，无论大小，对我们的使命和未来都弥足珍贵。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一份貢獻，無論大小，對我們的使命和未來都彌足珍貴。"
          }
        }
      }
    },
