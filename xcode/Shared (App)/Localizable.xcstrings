    "Browse the web safer, faster & with less ads.\nGet Ghostery for your browser." : {
      "comment" : "Message shared with the link to Ghostery, in two lines",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surfe sicherer, schneller & mit weniger Werbung.\nHol dir Ghostery für deinen Browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navega por la web de forma más segura, más rápida y con menos anuncios.\nConsigue Ghostery para tu navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naviguez de façon plus sûre, plus rapide et avec moins de publicités.\nInstallez Ghostery dans votre navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naviga sul web in modo più sicuro, più veloce e con meno pubblicità.\nScarica Ghostery per il tuo browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より安全に、より速く、広告の少ないウェブを。\nブラウザにGhosteryを追加しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 안전하고 빠르게, 광고는 적게 웹을 탐색하세요.\n브라우저에 Ghostery를 설치하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądaj internet bezpieczniej, szybciej i z mniejszą liczbą reklam.\nPobierz Ghostery do swojej przeglądarki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegue na web com mais segurança, mais rapidez e menos anúncios.\nInstale o Ghostery no seu navegador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользуйтесь интернетом безопаснее, быстрее и с меньшим количеством рекламы.\nУстановите Ghostery в свой браузер."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duyệt web an toàn hơn, nhanh hơn và ít quảng cáo hơn.\nCài Ghostery cho trình duyệt của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览网页更安全、更快速，广告更少。\n为您的浏览器安装 Ghostery。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽網頁更安全、更快速，廣告更少。\n為您的瀏覽器安裝 Ghostery。"
          }
        }
      }
    },
