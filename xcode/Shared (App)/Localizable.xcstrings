          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery помогает вам контролировать свои данные во всем интернете."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery giúp bạn kiểm soát dữ liệu của mình trên khắp web."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery 帮助您在整个网络中掌控自己的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery 協助您在整個網路上掌控自己的資料。"
          }
        }
      }
    },
    "Ghostery is actively blocking trackers, stopping annoying ads, and protecting your online privacy in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery blockiert im Hintergrund aktiv Tracker, stoppt lästige Werbung und schützt deine Privatsphäre im Netz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery bloquea activamente los rastreadores, detiene los anuncios molestos y protege tu privacidad en línea en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery bloque activement les trackers, arrête les publicités gênantes et protège votre vie privée en ligne en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery blocca attivamente i tracker, ferma le pubblicità fastidiose e protegge la tua privacy online in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghosteryはバックグラウンドでトラッカーをブロックし、煩わしい広告を止め、オンラインのプライバシーを守っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery가 백그라운드에서 트래커를 차단하고, 성가신 광고를 막고, 온라인 개인정보를 보호하고 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery aktywnie blokuje w tle trackery, zatrzymuje irytujące reklamy i chroni twoją prywatność w sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Ghostery está bloqueando ativamente rastreadores, impedindo anúncios irritantes e protegendo sua privacidade online em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery в фоновом режиме блокирует трекеры, останавливает назойливую рекламу и защищает вашу конфиденциальность в интернете."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery đang tích cực chặn trình theo dõi, ngăn quảng cáo phiền phức và bảo vệ quyền riêng tư trực tuyến của bạn trong nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery 正在后台主动拦截跟踪器、阻止烦人的广告，并保护您的在线隐私。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostery 正在背景主動阻擋追蹤器、擋下惱人的廣告，並保護您的線上隱私。"
          }
        }
      }
    },
    "Ghostery missing from a browser, or not behaving as expected? Our team will help." : {
      "localizations" : {
