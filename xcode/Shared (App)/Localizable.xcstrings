    },
    "Support our mission and help us develop even stronger protection against trackers and ads, making the web safer for everyone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstütze unsere Mission und hilf uns, einen noch stärkeren Schutz vor Trackern und Werbung zu entwickeln – für ein sichereres Web für alle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoya nuestra misión y ayúdanos a desarrollar una protección aún más sólida contra rastreadores y anuncios, para que la web sea más segura para todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soutenez notre mission et aidez-nous à développer une protection encore plus efficace contre les trackers et les publicités, pour un Web plus sûr pour tous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostieni la nostra missione e aiutaci a sviluppare una protezione ancora più efficace contro tracker e pubblicità, per un web più sicuro per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私たちのミッションを支援し、トラッカーや広告に対するさらに強力な保護の開発にご協力ください。すべての人にとってより安全なウェブを実現します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저희의 사명을 지원하고 트래커와 광고로부터 더욱 강력한 보호 기능을 개발할 수 있도록 도와주세요. 모두를 위한 더 안전한 웹을 만들어 갑니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wesprzyj naszą misję i pomóż nam rozwijać jeszcze skuteczniejszą ochronę przed trackerami i reklamami, aby internet był bezpieczniejszy dla wszystkich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoie nossa missão e ajude-nos a desenvolver uma proteção ainda mais forte contra rastreadores e anúncios, tornando a web mais segura para todos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддержите нашу миссию и помогите нам создавать еще более надежную защиту от трекеров и рекламы, делая интернет безопаснее для всех."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy ủng hộ sứ mệnh của chúng tôi và giúp chúng tôi phát triển lớp bảo vệ mạnh mẽ hơn nữa trước trình theo dõi và quảng cáo, để web an toàn hơn cho tất cả mọi người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持我们的使命，帮助我们开发更强大的跟踪器和广告防护，让网络对每个人都更安全。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持我們的使命，協助我們開發更強大的追蹤器和廣告防護，讓網路對每個人都更安全。"
          }
        }
      }
    },
