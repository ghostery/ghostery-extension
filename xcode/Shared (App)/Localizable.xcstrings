          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como colaborador, você apoia o desenvolvimento de todo o Ghostery Privacy Suite"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Став участником, вы поддержите разработку всего пакета Ghostery Privacy Suite"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
